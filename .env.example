# Google Gemini API key — dapatkan gratis (tanpa kartu kredit) di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai untuk fallback AI (cek model terbaru di Google AI Studio)
GEMINI_MODEL=gemini-3.5-flash-lite

# Token akses halaman web QR login (wajib diisi saat deploy publik, cegah orang lain akses QR)
QR_ACCESS_TOKEN=

# Nomor admin (format 62812xxxx, tanpa +/spasi) yang boleh pakai command khusus (opsional)
ADMIN_NUMBERS=

# Konfigurasi Mayar untuk generate invoice pembayaran dari alur pemesanan di bot WhatsApp
# (pakai API key yang sama dengan akun Mayar di site/server, scope harus read+write)
MAYAR_API_KEY=
MAYAR_ENV=production
